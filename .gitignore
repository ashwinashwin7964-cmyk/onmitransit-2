from pathlib import Path

content = """# ==============================
# Python
# ==============================
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
dist/
*.egg-info/
.eggs/
wheels/
pip-wheel-metadata/

# Virtual environments
.venv/
venv/
env/
ENV/

# Python tooling and test caches
.pytest_cache/
.mypy_cache/
.ruff_cache/
.tox/
.nox/
.coverage
.coverage.*
htmlcov/
.pyre/
.hypothesis/

# Jupyter
.ipynb_checkpoints/

# ==============================
# Secrets and local configuration
# ==============================
.env
.env.*
!.env.example
*.pem
*.key

# ==============================
# Logs and temporary files
# ==============================
*.log
logs/
tmp/
temp/
*.tmp
.DS_Store
Thumbs.db

# ==============================
# Generated datasets and local databases
# ==============================
# Keep data schemas, small curated sample data, and documentation in Git.
# Exclude large generated or local-only artifacts.
data/omnitransit_2m_telemetry.csv
data/omnitransit_blocks.db
data/trained_demand_model.json
data/dataset_analytics_summary.json

# Common generated data formats (uncomment if needed)
# data/*.parquet
# data/*.feather
# data/*.pkl
# data/*.joblib

# ==============================
# Frontend / Node
# ==============================
node_modules/
frontend/node_modules/
frontend/dist/
frontend/.vite/
npm-debug.log*
yarn-debug.log*
pnpm-debug.log*

# Build outputs
*.tsbuildinfo

# ==============================
# IDEs and editors
# ==============================
.vscode/
.idea/
*.swp
*.swo

# ==============================
# OS files
# ==============================
.DS_Store
.AppleDouble
.LSOverride
"""

path = Path("/mnt/data/.gitignore")
path.write_text(content, encoding="utf-8")
print(f"Created: {path}")
print(path.read_text(encoding="utf-8"))
